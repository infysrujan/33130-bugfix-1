{
  "definitions": [
    {
      "title": "Button",
      "id": "button",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/button/v1/button",
            "template": {
              "model": "button"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "button",
      "fields": [
        {
          "component": "aem-content",
          "name": "link",
          "label": "Link",
          "description": "Destination URL for the button"
        },
        {
          "component": "text",
          "name": "linkText",
          "label": "Text",
          "description": "Button label text",
          "required": true
        },
        {
          "component": "text",
          "name": "linkTitle",
          "label": "Title",
          "description": "Accessibility title attribute (optional)"
        },
        {
          "component": "select",
          "name": "linkType",
          "label": "Type",
          "description": "Button style variant",
          "valueType": "string",
          "value": "",
          "options": [
            {
              "name": "Primary",
              "value": "primary"
            },
            {
              "name": "Secondary",
              "value": "secondary"
            },
            {
              "name": "Tertiary",
              "value": "tertiary"
            }
          ]
        },
        {
          "component": "container",
          "name": "targetSettings",
          "label": "Target settings",
          "fields": [
            {
              "component": "boolean",
              "name": "targetLink",
              "label": "Open link in new tab",
              "description": "Enable to open the button link in a new browser tab",
              "valueType": "boolean",
              "value": false
            },
            {
              "component": "boolean",
              "name": "enableModal",
              "label": "Open link in modal",
              "description": "Enable this to open the button link in a modal overlay. Add the fragment path in the Link field above.",
              "valueType": "boolean",
              "value": false
            },
            {
              "component": "boolean",
              "name": "enableCookieModal",
              "label": "Open cookie modal",
              "description": "Enable this to open the cookie settings modal. Add the cookie-modal fragment path in the Link field above.",
              "valueType": "boolean",
              "value": false
            }
          ]
        }
      ]
    }
  ]
}
