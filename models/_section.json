{
  "definitions": [
    {
      "title": "Section",
      "id": "section",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/section/v1/section",
            "template": {
              "model": "section"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "section",
      "fields": [
        {
          "component": "text",
          "name": "id",
          "label": "Section ID",
          "description": "Used for deep linking — e.g. /page#Howto scrolls to the section with id 'Howto'"
        },
        {
          "component": "text",
          "name": "name",
          "label": "Section Name",
          "description": "The label shown for this section in the Content Tree"
        },
        {
          "component": "boolean",
          "label": "Enable this section to be a part of sub-navigation",
          "name": "is-subnav-section",
          "valueType": "boolean"
        },
        {
          "component": "text",
          "name": "subnav-label",
          "label": "Sub Navigation Title",
          "description": "This title will be displayed in the sub-navigation if the page has sub-navigation enabled.",
          "condition": {
            "===": [
              {
                "var": "is-subnav-section"
              },
              true
            ]
          }
        },
        {
          "component": "multiselect",
          "name": "style",
          "label": "Style",
          "valueType": "string",
          "required": false,
          "options": [
            {
              "name": "Section type",
              "children": [
                {
                  "name": "Central Aligned",
                  "value": "central-aligned"
                },
                {
                  "name": "Full Bleed Special",
                  "value": "full-bleed-special"
                },
                {
                  "name": "Full Bleed Background",
                  "value": "full-bleed-bg"
                }
              ]
            },
            {
              "name": "Background Color",
              "children": [
                {
                  "name": "Truthful Blue",
                  "value": "bg-truthful-blue"
                },
                {
                  "name": "Truthful Dark Blue",
                  "value": "bg-truthful-dark-blue"
                },
                {
                  "name": "Ice Blue",
                  "value": "bg-ice-blue"
                },
                {
                  "name": "Grey 10",
                  "value": "bg-grey-10"
                },
                {
                  "name": "Grey 05",
                  "value": "bg-grey-05"
                },
                {
                  "name": "Grey 100",
                  "value": "bg-grey-100"
                },
                {
                  "name": "Blue 01",
                  "value": "bg-blue-01"
                }
              ]
            },
            {
              "name": "Padding",
              "children": [
                {
                  "name": "Padding Top",
                  "value": "pad-top-30"
                },
                {
                  "name": "Padding Bottom",
                  "value": "pad-bot-30"
                }
              ]
            },
            {
              "name": "Layout",
              "children": [
                {
                  "name": "Columns 3",
                  "value": "columns-3"
                },
                {
                  "name":"Columns 2(75-25)",
                  "value": "columns-2-75"
                },
                {
                  "name":"Columns 2(50-50)",
                  "value": "columns-2-50"
                },
                {
                  "name":"Columns 2(65-35)",
                  "value": "columns-2-65"
                }
              ]
            },
            {
              "name": "Style",
              "children": [
                {
                  "name": "Underline Title",
                  "value": "underline-title"
                },
                {
                  "name": "Center Title",
                  "value": "center-title"
                },
                {
                  "name": "Center Image",
                  "value": "center-image"
                },
                {
                  "name": "Underline Image",
                  "value": "underline-image"
                },
                {
                  "name": "Center Content",
                  "value": "center-content"
                }
              ]
            },
            {
              "name": "Theme",
              "children": [
                {
                  "name": "Background Wealth",
                  "value": "background-wealth"
                },
                {
                  "name": "Background Private Banking",
                  "value": "background-privatebanking"
                }
              ]
            },
            {
              "name": "Forms Theme",
              "children": [
                {
                  "name": "Custom Forms",
                  "value": "custom-forms"
                },
                {
                  "name": "Lead Forms",
                  "value": "lead-forms"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
