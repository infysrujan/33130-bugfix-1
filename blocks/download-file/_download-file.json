              "valueType": "boolean",
              "value": false
            }
          ]
        },
        {
          "component": "boolean",
          "name": "boxedCard",
          "label": "Boxed Card",
          "description": "Enable to display as a boxed card",
          "valueType": "boolean",
          "value": false
        },
        {
          "component": "container",
          "name": "boxedCardSettings",
          "label": "Boxed Card Settings",
          "valueType": "object",
          "collapsible": true,
          "condition": {
            "===": [
              {
                "var": "boxedCard"
