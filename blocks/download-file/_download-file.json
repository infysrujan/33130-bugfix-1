              "options": [
                {
                  "name": "h1",
                  "value": "h1"
                },
                {
                  "name": "h2",
                  "value": "h2"
                },
                {
                  "name": "h3",
                  "value": "h3"
                },
                {
                  "name": "h4",
                  "value": "h4"
                },
                {
                  "name": "h5",
                  "value": "h5"
                },
                {
                  "name": "h6",
                  "value": "h6"
                }
              ]
            },
            {
              "component": "richtext",
              "name": "authorableDate",
              "label": "Authorable date",
              "valueType": "string",
              "value": ""
            }
          ]
        },
        {
          "component": "boolean",
          "name": "enableTermsConditionPopup",
          "label": "Enable Terms & Conditions Popup",
          "description": "If enabled, clicking the download button will show the terms & conditions popup before downloading",
          "valueType": "boolean",
          "value": false
