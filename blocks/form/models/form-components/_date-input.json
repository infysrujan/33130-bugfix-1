{
    "definitions": [
        {
            "title": "Date Input",
            "id": "date-input",
            "plugins": {
                "xwalk": {
                    "page": {
                        "resourceType": "core/fd/components/form/datepicker/v1/datepicker",
                        "template": {
                            "jcr:title": "Date Input",
                            "fieldType": "date-input"
                        }
                    }
                }
            }
        }
    ],
    "models": [
        {
            "id": "date-input",
            "fields": [
                {
                    "component": "tab",
                    "label": "Basic",
                    "name": "basic"
                },
                {
                    "...": "../form-common/_basic-input-placeholder-fields.json#/fields"
                },
                {
                    "component": "date-time",
                    "name": "default",
                    "label": "Default Value",
                    "valueType": "date"
                },
                {
                    "component": "text",
                    "name": "customClassName",
                    "label": "Custom CSS Class Name",
                    "description": "Enter one or more CSS class names (space-separated) to apply custom styling to this date input field wrapper.",
                    "valueType": "string"
                },
                {
                    "component": "tab",
                    "label": "Validation",
                    "name": "validation"
                },
                {
                    "...": "../form-common/_date-validation-fields.json#/fields"
                },
                {
                    "component": "tab",
                    "label": "Formats",
                    "name": "formats"
                },
                {
                    "component": "select",
                    "label": "Display Format",
                    "name": "displayFormat",
                    "valueType": "string",
                    "value": "dd/MM/yyyy",
                    "options": [
                        {
                            "name": "No Pattern",
                            "value": ""
                        },
                        {
                            "name": "DD/MM/YYYY (01/04/2007)",
                            "value": "dd/MM/yyyy"
                        },
                        {
                            "name": "01 April, 2007",
                            "value": "d MMMM, y"
                        },
                        {
                            "name": "April 01, 2007",
                            "value": "MMMM d, y"
                        },
                        {
                            "name": "Sunday, 01 April, 2007",
                            "value": "EEEE, d MMMM, y"
                        },
                        {
                            "name": "Sunday, April 01, 2007",
                            "value": "EEEE, MMMM d, y"
                        },
                        {
                            "name": "D/M/YYYY (1/4/2007)",
                            "value": "d/M/y"
                        }
                    ]
                },
                {
                    "component": "select",
                    "label": "Submit Value Format",
                    "name": "valueFormat",
                    "valueType": "string",
                    "value": "dd/MM/yyyy",
                    "description": "Format of the date value sent on form submission",
                    "options": [
                        {
                            "name": "DD/MM/YYYY (01/04/2007)",
                            "value": "dd/MM/yyyy"
                        },
                        {
                            "name": "YYYY-MM-DD (2007-04-01) — ISO 8601",
                            "value": "yyyy-MM-dd"
                        },
                        {
                            "name": "MM/DD/YYYY (04/01/2007)",
                            "value": "MM/dd/yyyy"
                        },
                        {
                            "name": "D/M/YYYY (1/4/2007)",
                            "value": "d/M/y"
                        }
                    ]
                },
                {
                    "...": "../form-common/_help-container.json#/fields"
                }
            ]
        }
    ]
}
