{
  "definitions": [
    {
      "title": "Forms Menu Card",
      "id": "forms-menu-card",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/fd/components/form/image/v1/image",
            "template": {
              "jcr:title": "Forms Menu Card",
              "fieldType": "image",
              "fd:viewType": "forms-menu-card"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "forms-menu-card",
      "fields": [
        {
          "component": "tab",
          "label": "Basic",
          "name": "basic"
        },
        {
          "component": "text",
          "name": "name",
          "label": "Name",
          "valueType": "string",
          "required": true,
          "valueFormat": "regexp",
          "validation": {
            "regExp": "^[^$].*",
            "customErrorMsg": "Name cannot start with $"
          }
        },
        {
          "component": "boolean",
          "name": "visible",
          "label": "Show Component",
          "valueType": "boolean",
          "value": true
        },
        {
          "component": "select",
          "name": "colspan",
          "label": "Column Span",
          "valueType": "string",
          "value": "12",
          "options": [
            { "name": "1 column", "value": "1" },
            { "name": "2 column", "value": "2" },
            { "name": "3 column", "value": "3" },
            { "name": "4 column", "value": "4" },
            { "name": "5 column", "value": "5" },
            { "name": "6 column", "value": "6" },
            { "name": "7 column", "value": "7" },
            { "name": "8 column", "value": "8" },
            { "name": "9 column", "value": "9" },
            { "name": "10 column", "value": "10" },
            { "name": "11 column", "value": "11" },
            { "name": "12 column", "value": "12" }
          ]
        },
        {
          "component": "tab",
          "label": "Cards",
          "name": "cards"
        },
        {
          "component": "text",
          "name": "properties.cardIcons",
          "label": "Card Icon",
          "valueType": "string",
          "multi": true,
          "description": "Asset path for each card icon, one per row (e.g. /content/dam/bbl/icons/calendar.svg). Order must match Card Titles."
        },
        {
          "component": "text",
          "name": "properties.cardTitles",
          "label": "Card Title",
          "valueType": "string",
          "multi": true,
          "required": true,
          "description": "Title for each card, one per row. Order must match Card Icons and Card Descriptions."
        },
        {
          "component": "richtext",
          "name": "properties.cardDescriptions",
          "label": "Card Descriptions",
          "valueType": "string",
          "multi": true,
          "description": "Description for each card, one per row. Supports inline HTML (e.g. asterisk footnotes). Order must match Card Titles."
        }
      ]
    }
  ]
}
