{
  "definitions": [
    {
      "title": "Forms Card List Item",
      "id": "forms-card-list-item",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/fd/components/form/image/v1/image",
            "template": {
              "jcr:title": "Forms Card List Item",
              "fieldType": "image",
              "fd:viewType": "forms-card-list-item"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "forms-card-list-item",
      "fields": [
        {
          "component": "tab",
          "label": "Basic",
          "name": "basic"
        },
        {
          "component": "text",
          "name": "name",
          "label": "Name",
          "valueType": "string",
          "required": true,
          "valueFormat": "regexp",
          "validation": {
            "regExp": "^[^$].*",
            "customErrorMsg": "Name cannot start with $"
          }
        },
        {
          "component": "boolean",
          "name": "visible",
          "label": "Show Component",
          "valueType": "boolean",
          "value": true
        },
        {
          "component": "tab",
          "label": "Card",
          "name": "card"
        },
        {
          "component": "reference",
          "valueType": "string",
          "name": "cardListImage",
          "label": "Card List Image",
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "cardListImageAlt",
          "label": "Alt",
          "value": ""
        },
        {
          "component": "text",
          "name": "promoTag",
          "label": "Promo Tag",
          "valueType": "string"
        },
        {
          "component": "text",
          "name": "title",
          "label": "Title",
          "valueType": "string"
        },
        {
          "component": "select",
          "name": "titleType",
          "label": "Title Type",
          "options": [
            { "name": "h1", "value": "h1" },
            { "name": "h2", "value": "h2" },
            { "name": "h3", "value": "h3" },
            { "name": "h4", "value": "h4" },
            { "name": "h5", "value": "h5" },
            { "name": "h6", "value": "h6" }
          ]
        },
        {
          "component": "text",
          "name": "subtitle",
          "label": "Subtitle",
          "valueType": "string",
          "value": ""
        },
        {
          "component": "richtext",
          "name": "description",
          "label": "Description",
          "valueType": "string",
          "value": ""
        },
        {
          "component": "richtext",
          "name": "remark-text",
          "label": "Remark Text",
          "valueType": "string",
          "value": ""
        },
        {
          "component": "select",
          "name": "imageLayout",
          "label": "Image Layout",
          "valueType": "string",
          "value": "default",
          "options": [
            { "name": "Full",    "value": "full" },
            { "name": "Default", "value": "default" },
            { "name": "Card",    "value": "card" },
            { "name": "X-Small", "value": "x-small" },
            { "name": "Logo",    "value": "logo" },
            { "name": "Profile", "value": "profile" }
          ]
        },
        {
          "component": "boolean",
          "name": "enableTitleUnderline",
          "label": "Underline Title",
          "description": "If enabled, the title will be underlined.",
          "valueType": "boolean",
          "value": false
        },
        {
          "component": "select",
          "valueType": "string",
          "description": "Select type of button action",
          "name": "buttonActionType",
          "value": "default",
          "label": "Button Action Type",
          "options": [
            { "name": "Default Button",    "value": "default-button" },
            { "name": "Multiple Download", "value": "multiple-download" },
            { "name": "Select Dropdown",   "value": "select-dropdown" }
          ]
        },
        {
          "component": "aem-content",
          "name": "link",
          "label": "Link",
          "description": "Destination URL for the button",
          "condition": {
            "===": [{ "var": "buttonActionType" }, "default-button"]
          }
        },
        {
          "component": "text",
          "name": "linkText",
          "label": "Text",
          "description": "Button label text",
          "required": true,
          "condition": {
            "===": [{ "var": "buttonActionType" }, "default-button"]
          }
        },
        {
          "component": "text",
          "name": "linkTitle",
          "label": "Title",
          "description": "Accessibility title attribute (optional)",
          "condition": {
            "===": [{ "var": "buttonActionType" }, "default-button"]
          }
        },
        {
          "component": "select",
          "name": "linkType",
          "label": "Type",
          "description": "Button style variant",
          "valueType": "string",
          "value": "",
          "options": [
            { "name": "Primary",   "value": "primary" },
            { "name": "Secondary", "value": "secondary" },
            { "name": "Tertiary",  "value": "tertiary" }
          ],
          "condition": {
            "===": [{ "var": "buttonActionType" }, "default-button"]
          }
        },
        {
          "component": "boolean",
          "name": "targetLink",
          "label": "Open link in new tab",
          "description": "Enable to open the button link in a new browser tab",
          "valueType": "boolean",
          "value": false,
          "condition": {
            "===": [{ "var": "buttonActionType" }, "default-button"]
          }
        },
        {
          "component": "richtext",
          "name": "multipleDownloadLinks",
          "label": "Multiple Download Links",
          "valueType": "string",
          "value": "",
          "condition": {
            "===": [{ "var": "buttonActionType" }, "multiple-download"]
          }
        },
        {
          "component": "text",
          "name": "dropdownLable",
          "label": "Dropdown Label",
          "description": "Dropdown label text for dropdown links",
          "condition": {
            "===": [{ "var": "buttonActionType" }, "select-dropdown"]
          }
        },
        {
          "component": "richtext",
          "name": "drop-links",
          "label": "Dropdown Links",
          "valueType": "string",
          "value": "",
          "condition": {
            "===": [{ "var": "buttonActionType" }, "select-dropdown"]
          }
        },
        {
          "component": "boolean",
          "name": "isCardClickable",
          "label": "Full Card Clickable",
          "description": "If enabled, the entire card will be clickable.",
          "valueType": "boolean",
          "value": false
        },
        {
          "component": "aem-content",
          "name": "cardLink",
          "label": "Link",
          "description": "Destination URL for the clickable card",
          "condition": {
            "!!": [{ "var": "isCardClickable" }]
          }
        },
        {
          "component": "text",
          "name": "cardLinkTitle",
          "label": "Link Title",
          "description": "Accessibility title attribute for the clickable card (optional)",
          "condition": {
            "!!": [{ "var": "isCardClickable" }]
          }
        },
        {
          "component": "boolean",
          "name": "enableOverlayModal",
          "label": "Enable Overlay Modal",
          "description": "If enabled, an overlay modal will be displayed.",
          "valueType": "boolean",
          "value": false
        },
        {
          "component": "aem-content",
          "name": "fragmentPath",
          "label": "Fragment Path",
          "valueType": "string",
          "condition": {
            "!!": [{ "var": "enableOverlayModal" }]
          }
        },
        {
          "component": "date-time",
          "name": "financialDate",
          "label": "Financial Date",
          "valueType": "string"
        }
      ]
    }
  ]
}
