{
  "definitions": [
    {
      "title": "Date of Birth (Thai)",
      "id": "dob",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/fd/components/form/datepicker/v1/datepicker",
            "template": {
              "jcr:title": "Date of Birth (Thai)",
