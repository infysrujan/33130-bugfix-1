            { "name": "2 column", "value": "2" },
            { "name": "3 column", "value": "3" },
            { "name": "4 column", "value": "4" },
            { "name": "5 column", "value": "5" },
            { "name": "6 column", "value": "6" },
            { "name": "7 column", "value": "7" },
