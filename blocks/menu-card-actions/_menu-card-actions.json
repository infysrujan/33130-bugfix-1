{
  "definitions": [
    {
      "title": "Menu Card Actions",
      "id": "menu-card-actions",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Menu Card Actions",
              "model": "menu-card-actions",
              "filter": "menu-card-actions"
            }
          }
        }
      }
    },
    {
      "title": "Menu Card Item",
      "id": "menu-card-item",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Menu Card Item",
              "model": "menu-card-item"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "menu-card-actions",
      "fields": [
        {
          "component": "select",
          "name": "mobileExperience",
          "value": "default",
          "label": "Mobile Experience",
          "valueType": "string",
          "options": [
            { 
              "name": "Scrollable", 
              "value": "scrollable" 
            },
            {
              "name": "Stacked", 
              "value": "stacked" 
            }
          ]
        }
      ]
    },
    {
      "id": "menu-card-item",
      "fields": [
        {
          "component": "reference",
          "valueType": "string",
          "name": "menuCardImage",
          "label": "Menu Card Image",
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "menuCardImageAlt",
          "label": "Alt",
          "value": ""
        },
        {
          "component": "text",
          "name": "title",
          "label": "Title"
        },
        {
          "component": "select",
          "name": "titleType",
          "label": "Title Type",
          "value": "h3",
          "options": [
            {
              "name": "h1",
              "value": "h1"
            },
            {
              "name": "h2",
              "value": "h2"
            },
            {
              "name": "h3",
              "value": "h3"
            },
            {
              "name": "h4",
              "value": "h4"
            },
            {
              "name": "h5",
              "value": "h5"
            },
            {
              "name": "h6",
              "value": "h6"
            }
          ]
        },
        {
          "component": "richtext",
          "name": "description",
          "value": "",
          "label": "Description",
          "valueType": "string"
        },
        {
          "component": "select",
          "valueType": "string",
          "description": "Select type of button action",
          "name": "buttonActionType",
          "value": "default",
          "label": "Button ActionType",
          "options": [
            { "name": "Default", "value": "default" },
            { "name": "Download", "value": "download" },
            { "name": "Multiple Download", "value": "multiple-download" },
            { "name": "Select Dropdown", "value": "select-dropdown" }
          ]
        },
        {
          "component": "aem-content",
          "name": "link",
          "label": "Link",
          "description": "Destination URL for the button",
          "condition": {
            "===": [
              {
                "var": "buttonActionType"
              },
              "default"
            ]
          }
        },
        {
          "component": "text",
          "name": "linkText",
          "label": "Text",
          "description": "Button label text",
          "required": true,
          "condition": {
            "===": [
              {
                "var": "buttonActionType"
              },
              "default"
            ]
          }
        },
        {
          "component": "text",
          "name": "linkTitle",
          "label": "Title",
          "description": "Accessibility title attribute (optional)",
          "condition": {
            "===": [
              {
                "var": "buttonActionType"
              },
              "default"
            ]
          }
        },
        {
          "component": "select",
          "name": "linkType",
          "label": "Type",
          "description": "Button style variant",
          "valueType": "string",
          "value": "",
          "options": [
            {
              "name": "Primary",
              "value": "primary"
            },
            {
              "name": "Secondary",
              "value": "secondary"
            },
            {
              "name": "Tertiary",
              "value": "tertiary"
            }
          ],
          "condition": {
            "===": [
              {
                "var": "buttonActionType"
              },
              "default"
            ]
          }
        },
        {
          "component": "container",
          "name": "defaultTargetLinkSettings",
          "label": "Target settings",
          "condition": {
            "===": [{ "var": "buttonActionType" }, "default"]
          },
          "fields": [
            {
              "component": "boolean",
              "name": "defaultTargetLink",
              "label": "Open link in new tab",
              "description": "Enable to open the button link in a new browser tab",
              "valueType": "boolean",
              "value": false
            }
          ]
        },
        {
          "component": "aem-content",
          "name": "downloadLink",
          "label": "Download Link",
          "description": "Download Link for the button",
          "condition": {
            "===": [
              {
                "var": "buttonActionType"
              },
              "download"
            ]
          }
        },
        {
          "component": "text",
          "name": "downloadLinkText",
          "label": "Download Text",
          "description": "Download Button label text",
          "required": true,
          "condition": {
            "===": [
              {
                "var": "buttonActionType"
              },
              "download"
            ]
          }
        },
        {
          "component": "text",
          "name": "downloadLinkTitle",
          "label": "Download Title",
          "description": "Accessibility title attribute (optional)",
          "condition": {
            "===": [
              {
                "var": "buttonActionType"
              },
              "download"
            ]
          }
        },
        {
          "component": "container",
          "name": "downloadTargetLinkSettings",
          "label": "Target settings",
          "condition": {
            "===": [{ "var": "buttonActionType" }, "download"]
          },
          "fields": [
            {
              "component": "boolean",
              "name": "downloadTargetLink",
              "label": "Open link in new tab",
              "description": "Enable to open the button link in a new browser tab",
              "valueType": "boolean",
              "value": false
            }
          ]
        },
        {
          "component": "text",
          "name": "dropdownLable",
          "label": "Dropdown Lable",
          "description": "Dropdown lable text for dropdown links",
          "condition": {
            "===": [
              {
                "var": "buttonActionType"
              },
              "select-dropdown"
            ]
          }
        },
        {
          "component": "richtext",
          "name": "drop-links",
          "value": "",
          "label": "Dropdown Links",
          "valueType": "string",
          "condition": {
            "and": [
              {
                "===": [
                  {
                    "var": "buttonActionType"
                  },
                  "select-dropdown"
                ]
              }
            ]
          }
        },
        {
          "component": "richtext",
          "name": "multipleDownloadLinks",
          "value": "",
          "label": "Multiple Download Links",
          "valueType": "string",
          "condition": {
            "===": [
              {
                "var": "buttonActionType"
              },
              "multiple-download"
            ]
          }
        },
        {
          "component": "boolean",
          "name": "isCardClickable",
          "label": "Full Card Clickable",
          "description": "If enabled, the entire card will be clickable.",
          "valueType": "boolean",
          "value": false
        },
        {
          "component": "aem-content",
          "name": "cardLink",
          "label": "Link",
          "description": "Destination URL for the clickable card",
          "condition": {
            "!!": [
              {
                "var": "isCardClickable"
              }
            ]
          }
        },
        {
          "component": "text",
          "name": "cardLinkTitle",
          "label": "Link Title",
          "description": "Accessibility title attribute for the clickable card (optional)",
          "condition": {
            "!!": [
              {
                "var": "isCardClickable"
              }
            ]
          }
        },
        {
          "component": "boolean",
          "name": "enableOverlayModal",
          "label": "Enable Overlay Modal",
          "description": "If enabled, an overlay modal will be displayed.",
          "valueType": "boolean",
          "value": false
        },
        {
          "component": "aem-content",
          "name": "fragmentPath",
          "label": "Fragment path",
          "valueType": "string",
          "condition": {
            "!!": [
              {
                "var": "enableOverlayModal"
              }
            ]
          }
        },
        {
          "component": "date-time",
          "name": "financialDate",
          "label": "Financial Date",
          "valueType": "string"
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "menu-card-actions",
      "components": [
        "menu-card-item"
      ]
    }
  ]
}