{
  "definitions": [
    {
      "title": "Hero",
      "id": "hero",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Hero",
              "filter": "hero",
              "model": "hero",
              "label": "Add up to 6 hero banner items"
            }
          }
        }
      }
    },
    {
      "title": "Hero Item",
      "id": "hero-item",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Hero Item",
              "model": "hero-item",
              "label": "Maximum 6 items allowed"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "hero",
      "fields": [
        {
          "component": "select",
          "name": "variant",
          "value": "default",
          "label": "Variant",
          "valueType": "string",
          "options": [
            {
              "name": "Hero With Thumbnail Images",
              "value": "hero-with-thumbnail-images"
            },
            {
              "name": "Simple",
              "value": "simple"
            },
            {
              "name": "Private or Wealth banking",
              "value": "private-wealth-banking"
            },
            {
              "name": "Simple with Logo Banner",
              "value": "simple-logo-banner"
            }
          ]
        }
      ]
    },
    {
      "id": "hero-item",
      "fields": [
        {
          "component": "select",
          "name": "mediaType",
          "value": "images",
          "label": "Media Type",
          "valueType": "string",
          "description": "Select the media type. 'BG Video' options are only used for the 'Hero With Thumbnail Images' variant.",
          "options": [
            {
              "name": "Image",
              "value": "images"
            },
            {
              "name": "BG Video – YouTube",
              "value": "youtube-url"
            },
            {
              "name": "BG Video – DAM Video",
              "value": "dam-video"
            }
          ]
        },
        {
          "component": "custom-asset-namespace:custom-asset",
          "name": "imagePickerDesktop",
          "label": "Image (Desktop)",
          "description": "Select an image shown at desktop breakpoints",
          "configUrl": "/content/dam/image.config.json",
          "valueType": "string",
          "condition": {
            "or": [
              { "===": [{ "var": "mediaType" }, "images"] },
              { "===": [{ "var": "mediaType" }, ""] }
            ]
          }
        },
        {
          "component": "custom-asset-namespace:custom-asset-mimetype",
          "valueType": "string",
          "name": "imagePickerDesktopMimeType"
        },
        {
          "component": "custom-asset-namespace:custom-asset",
          "name": "imagePickerMobile",
          "label": "Image (Mobile)",
          "description": "Select an image shown at mobile breakpoints",
          "configUrl": "/content/dam/image.config.json",
          "valueType": "string",
          "condition": {
            "or": [
              { "===": [{ "var": "mediaType" }, "images"] },
              { "===": [{ "var": "mediaType" }, ""] }
            ]
          }
        },
        {
          "component": "custom-asset-namespace:custom-asset-mimetype",
          "valueType": "string",
          "name": "imagePickerMobileMimeType"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "imagePickerAlt",
          "label": "Alternative text for accessibility",
          "description": "Write descriptive, concise, relevant alt text to describe the image in context, enhancing accessibility for visually impaired users and improving SEO.",
          "condition": {
            "or": [
              { "===": [{ "var": "mediaType" }, "images"] },
              { "===": [{ "var": "mediaType" }, ""] }
            ]
          }
        },
        {
          "component": "text",
          "name": "youtubeUrl",
          "label": "YouTube URL",
          "description": "Enter the YouTube video URL.",
          "valueType": "string",
          "condition": {
            "===": [{ "var": "mediaType" }, "youtube-url"]
          }
        },
        {
          "component": "reference",
          "name": "damVideoAsset",
          "label": "Video Asset",
          "description": "Choose or upload an MP4 video file from DAM.",
          "valueType": "string",
          "multi": false,
          "condition": {
            "===": [{ "var": "mediaType" }, "dam-video"]
          }
        },
        {
          "component": "reference",
          "valueType": "string",
          "name": "logoImage",
          "label": "Logo Image",
          "multi": false,
          "description": "Optional logo image (for logo variants)"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "logoImageAlt",
          "label": "Logo Alt",
          "value": ""
        },
        {
          "component": "reference",
          "valueType": "string",
          "name": "homeThumbImage",
          "label": "Thumbnail Image",
          "multi": false,
          "description": "Only used for 'Hero With Thumbnail Images' variant"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "homeThumbImageAlt",
          "label": "Thumbnail Alt",
          "value": "",
          "description": "Only used for 'Hero With Thumbnail Images' variant"
        },
        {
          "component": "richtext",
          "name": "title",
          "value": "",
          "label": "Title",
          "valueType": "string",
          "description": "Optional for 'Simple with Logo Only' variant"
        },
        {
          "component": "richtext",
          "name": "subtitle",
          "value": "",
          "label": "Sub Title",
          "valueType": "string"
        },
        {
          "...": "../../models/elements/_button-fields.json"
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "hero",
      "components": [
        "hero-item"
      ],
      "maxItems": 8
    }
  ]
}
