{
  "definitions": [
    {
      "title": "Card List",
      "id": "card-list",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Card List",
              "model":"card-list",
              "filter": "card-list"
            }
          }
        }
      }
    },
    {
      "title": "Card List Item",
      "id": "card-list-item",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Card List Item",
              "model": "card-list-item"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "card-list",
      "fields": [
        {
          "component": "select",
          "name": "cardListLayout",
          "value": "default",
          "label": "Card List Layout",
          "valueType": "string",
          "options": [
            {
              "name": "Stacked", 
              "value": "stacked" 
            },
            { 
              "name": "Scrollable", 
              "value": "scrollable" 
            },
            {
              "name": "Carousel", 
              "value": "carousel" 
            }
          ]
        },
        {
          "component": "select",
          "name": "cardListAlignment",
          "value": "default",
          "label": "Card List Alignment",
          "valueType": "string",
          "options": [
            {
              "name": "Center", 
              "value": "center" 
            },
            { 
              "name": "Left", 
              "value": "left" 
            }
          ]
        },
         {
          "component": "select",
          "name": "cardsPerRow",
          "value": "default",
          "label": "Cards Per Row",
          "valueType": "string",
          "options": [
            {
              "name": "1 Card Per Row", 
              "value": "cards-1" 
            },
            { 
              "name": "3 Cards Per Row", 
              "value": "cards-3" 
            },
            { 
              "name": "4 Cards Per Row", 
              "value": "cards-4" 
            }
          ]
        }
      ]
    },
    {
      "id": "card-list-item",
      "fields": [
        {
          "component": "reference",
          "valueType": "string",
          "name": "cardListImage",
          "label": "Card List Image",
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "cardListImageAlt",
          "label": "Alt",
          "value": ""
        },
        {
          "component": "text",
          "name": "promoTag",
          "label": "Promo Tag",
          "valueType": "string"
        },
        {
          "component": "text",
          "name": "title",
          "label": "Title"
        },
        {
          "component": "select",
          "name": "titleType",
          "label": "Title Type",
          "options": [
            {
              "name": "h1",
              "value": "h1"
            },
            {
              "name": "h2",
              "value": "h2"
            },
            {
              "name": "h3",
              "value": "h3"
            },
            {
              "name": "h4",
              "value": "h4"
            },
            {
              "name": "h5",
              "value": "h5"
            },
            {
              "name": "h6",
              "value": "h6"
            }
          ]
        },
        {
          "component": "richtext",
          "name": "description",
          "value": "",
          "label": "Description",
          "valueType": "string"
        },
        {
          "component": "richtext",
          "name": "remark-text",
          "value": "",
          "label": "Remark Text",
          "valueType": "string"
        },
        {
          "component": "aem-content",
          "name": "link",
          "label": "Link",
          "description": "Destination URL for the button"
        },
        {
          "component": "text",
          "name": "linkText",
          "label": "Text",
          "description": "Button label text",
          "required": true
        },
        {
          "component": "text",
          "name": "linkTitle",
          "label": "Title",
          "description": "Accessibility title attribute (optional)"
        },
        {
          "component": "select",
          "name": "linkType",
          "label": "Type",
          "description": "Button style variant",
          "valueType": "string",
          "value": "",
          "options": [
            {
              "name": "Primary",
              "value": "primary"
            },
            {
              "name": "Secondary",
              "value": "secondary"
            },
            {
              "name": "Tertiary",
              "value": "tertiary"
            }
          ]
        },
        {
          "component": "container",
          "name": "targetSettings",
          "label": "Target settings",
          "fields": [
            {
              "component": "boolean",
              "name": "targetLink",
              "label": "Open link in new tab",
              "description": "Enable to open the button link in a new browser tab",
              "valueType": "boolean",
              "value": false
            }
          ]
        },
        {
          "component": "select",
          "name": "imageLayout",
          "label": "Image Layout",
          "valueType": "string",
          "value": "default",
          "options": [
            {
              "name": "Full",
              "value": "full"
            },
            {
              "name": "Default",
              "value": "default"
            },
            {
              "name": "Card",
              "value": "card"
            },
            {
              "name": "X-Small",
              "value": "x-small"
            }
          ]
        },
        {
          "component": "boolean",
          "name": "enableTitleUnderline",
          "label": "Underline Title",
          "description": "If enabled, the title will be underlined.",
          "valueType": "boolean",
          "value": false
        },
        {
          "component": "boolean",
          "name": "isCardClickable",
          "label": "Full Card Clickable",
          "description": "If enabled, the entire card will be clickable.",
          "valueType": "boolean",
          "value": false
        },
        {
          "component": "aem-content",
          "name": "cardLink",
          "label": "Link",
          "description": "Destination URL for the clickable card",
          "condition": {
            "!!": [
              {
                "var": "isCardClickable"
              }
            ]
          }
        },
        {
          "component": "text",
          "name": "cardLinkTitle",
          "label": "Link Title",
          "description": "Accessibility title attribute for the clickable card (optional)",
          "condition": {
            "!!": [
              {
                "var": "isCardClickable"
              }
            ]
          }
        },
        {
          "component": "boolean",
          "name": "enableOverlayModal",
          "label": "Enable Overlay Modal",
          "description": "If enabled, an overlay modal will be displayed.",
          "valueType": "boolean",
          "value": false
        },
        {
          "component": "aem-content",
          "name": "fragmentPath",
          "label": "Fragment path",
          "valueType": "string",
          "condition": {
            "!!": [
              {
                "var": "enableOverlayModal"
              }
            ]
          }
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "card-list",
      "components": [
        "card-list-item"
      ]
    }
  ]
}
