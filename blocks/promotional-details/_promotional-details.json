        {
          "component": "richtext",
          "name": "responsibleLendingDisclaimerText",
          "label": "Disclaimer Text (appears on the promotional page)",
          "valueType": "string",
          "condition": { "!!": [{ "var": "responsibleLendingDisclaimerEnabled" }] }
