          "label": "Table 1 Link",
          "description": "Destination URL for the button"
        },
        {
          "component": "text",
          "name": "table1LinkText",
          "label": "Table 1 Button Text",
          "description": "Button label text",
          "required": true
        },
        {
          "component": "text",
          "name": "table1LinkTitle",
          "label": "Table 1 Button Title",
          "description": "Accessibility title attribute (optional)"
        },
        {
          "component": "select",
          "name": "table1LinkType",
          "label": "Table 1 Button Type",
          "description": "Button style variant",
          "valueType": "string",
          "value": "",
          "options": [
            {
              "name": "Primary",
              "value": "primary"
