            {
              "component": "boolean",
              "name": "table1TargetLink",
              "label": "Open link in new tab",
              "description": "Enable to open the button link in a new browser tab",
              "valueType": "boolean",
              "value": false
            }
          ]
        },
        {
          "component": "richtext",
          "name": "table2ColumnNames",
          "label": "Table 2 Column Names",
          "valueType": "string",
          "condition": {
            "===": [
              {
                "var": "tableCount"
