        {
          "component": "text",
          "name": "title",
          "label": "Title"
        },
        {
          "component": "richtext",
          "name": "description",
          "label": "Description",
          "valueType": "string"
        },
        {
          "component": "reference",
          "name": "imageUrl",
          "label": "Image",
          "valueType": "string",
          "multi": false
        },
        {
          "component": "header",
          "label": "Card Selection"
        },
        {
          "component": "boolean",
          "name": "platinum",
          "label": "454628 - M Visa Platinum",
          "valueType": "boolean",
          "value": false
        },
        {
          "component": "boolean",
          "name": "signature",
          "label": "473014 - M Visa Signature",
          "valueType": "boolean",
          "value": false
