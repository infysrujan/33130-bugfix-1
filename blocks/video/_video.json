{
  "definitions": [
    {
      "title": "Video",
      "id": "video",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Video",
              "filter": "video",
              "model": "video",
              "label": "Add a video block"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "video",
      "fields": [
        {
          "component": "select",
          "name": "mediaType",
          "label": "Media Type",
          "description": "Choose how to provide the video.",
          "valueType": "string",
          "required": true,
          "value": "youtube-url",
          "options": [
            {
              "name": "Video from YouTube",
              "value": "youtube-url"
            },
            {
              "name": "Video From DAM",
              "value": "dam-video"
            },
            {
              "name": "Video From CTA",
              "value": "cta-video"
            },
            {
              "name": "Video From Image",
              "value": "image-video"
            }
          ]
        },
        {
          "component": "text",
          "name": "youtubeUrl",
          "label": "YouTube URL",
          "description": "Enter the YouTube video URL.",
          "valueType": "string",
          "condition": {
            "===": [
              {
                "var": "mediaType"
              },
              "youtube-url"
            ]
          }
        },
        {
          "component": "reference",
          "name": "damVideoAsset",
          "label": "Video Asset",
          "description": "Choose or upload an MP4 video file from DAM.",
          "valueType": "string",
          "multi": false,
          "condition": {
            "===": [
              {
                "var": "mediaType"
              },
              "dam-video"
            ]
          }
        },
        {
          "component": "reference",
          "name": "ctaVideoAsset",
          "label": "Video Asset",
          "description": "Browse and select a video file from DAM.",
          "valueType": "string",
          "multi": false,
          "condition": {
            "===": [
              {
                "var": "mediaType"
              },
              "cta-video"
            ]
          }
        },
        {
          "component": "text",
          "name": "ctaButtonName",
          "label": "Button Name",
          "description": "The display name of the CTA button.",
          "valueType": "string",
          "condition": {
            "===": [
              {
                "var": "mediaType"
              },
              "cta-video"
            ]
          }
        },
        {
          "component": "text",
          "name": "ctaButtonTitle",
          "label": "Button Title",
          "description": "The title attribute of the CTA button (tooltip text).",
          "valueType": "string",
          "condition": {
            "===": [
              {
                "var": "mediaType"
              },
              "cta-video"
            ]
          }
        },
        {
          "component": "reference",
          "name": "imageVideoAsset",
          "label": "Video Asset",
          "description": "Choose or upload an MP4 video file. Clicking the image will open this video in a new tab.",
          "valueType": "string",
          "multi": false,
          "condition": {
            "===": [
              {
                "var": "mediaType"
              },
              "image-video"
            ]
          }
        },
        {
          "component": "reference",
          "name": "imageAsset",
          "label": "Image",
          "description": "Choose an image to display. Clicking it opens the video in a new tab.",
          "valueType": "string",
          "multi": false,
          "condition": {
            "===": [
              {
                "var": "mediaType"
              },
              "image-video"
            ]
          }
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "video",
      "components": [
        "video"
      ]
    }
  ]
}
