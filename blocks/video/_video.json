{
  "definitions": [
    {
      "title": "Video",
      "id": "video",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Video",
              "filter": "video",
              "model": "video",
              "label": "Add a video block"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "video",
      "fields": [
        {
          "component": "select",
          "name": "mediaType",
          "label": "Media Type",
          "description": "Choose how to provide the video.",
          "valueType": "string",
          "required": true,
          "value": "youtube-url",
          "options": [
            {
              "name": "Video from YouTube",
              "value": "youtube-url"
            }
          ]
        },
        {
          "component": "text",
          "name": "youtubeUrl",
          "label": "YouTube URL",
          "description": "Enter the YouTube video URL.",
          "valueType": "string",
          "condition": {
            "===": [
              {
                "var": "mediaType"
              },
              "youtube-url"
            ]
          }
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "video",
      "components": [
        "video"
      ]
    }
  ]
}
