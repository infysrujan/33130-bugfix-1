{
  "definitions": [
    {
      "title": "Video",
      "id": "video",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Video",
              "model": "video"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "video",
      "fields": [
        {
          "component": "select",
          "name": "videoType",
          "label": "Video Type",
          "valueType": "string",
          "description": "Select whether to embed a YouTube video URL or link to a DAM asset via CTA",
          "options": [
            {
              "name": "Video URL",
              "value": "videourl"
            },
            {
              "name": "CTA",
              "value": "cta"
            },
            {
              "name": "Image",
              "value": "image"
            }
          ]
        },
        {
          "component": "text",
          "name": "youtubeUrl",
          "label": "YouTube URL",
          "valueType": "string",
          "description": "Enter the full YouTube video URL (e.g. https://www.youtube.com/watch?v=xxxxx)",
          "condition": {
            "===": [
              {
                "var": "videoType"
              },
              "videourl"
            ]
          }
        },
        {
          "component": "aem-content",
          "name": "damAssetPath",
          "label": "DAM Asset Path",
          "description": "Select the video or media asset from the DAM",
          "condition": {
            "===": [
              {
                "var": "videoType"
              },
              "cta"
            ]
          }
        },
        {
          "component": "text",
          "name": "ctaButtonName",
          "label": "Button Name",
          "valueType": "string",
          "description": "The visible label displayed on the CTA button",
          "condition": {
            "===": [
              {
                "var": "videoType"
              },
              "cta"
            ]
          }
        },
        {
          "component": "text",
          "name": "ctaButtonTitle",
          "label": "Button Title",
          "valueType": "string",
          "description": "Accessibility title attribute for the CTA button (tooltip on hover)",
          "condition": {
            "===": [
              {
                "var": "videoType"
              },
              "cta"
            ]
          }
        },
        {
          "component": "aem-content",
          "name": "imageVideoDamPath",
          "label": "Video DAM Asset Path",
          "description": "Select the video asset from the DAM to open when the image is clicked",
          "condition": {
            "===": [
              {
                "var": "videoType"
              },
              "image"
            ]
          }
        },
        {
          "component": "reference",
          "valueType": "string",
          "name": "imageDamPath",
          "label": "Image",
          "description": "Select the image from the DAM to display as the clickable thumbnail",
          "condition": {
            "===": [
              {
                "var": "videoType"
              },
              "image"
            ]
          }
        }
      ]
    }
  ],
  "filters": []
}
