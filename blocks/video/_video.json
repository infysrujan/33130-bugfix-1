{
  "definitions": [
    {
      "title": "Video",
      "id": "video",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Video",
              "model": "video"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "video",
      "fields": [
        {
          "component": "select",
          "name": "videoType",
          "label": "Video Type",
          "valueType": "string",
          "description": "Select whether to embed a YouTube video URL or link to a DAM asset via CTA",
          "options": [
            {
              "name": "Video URL",
              "value": "videourl"
            },
            {
              "name": "CTA",
              "value": "cta"
            }
          ]
        },
        {
          "component": "text",
          "name": "youtubeUrl",
          "label": "YouTube URL",
          "valueType": "string",
          "description": "Enter the full YouTube video URL (e.g. https://www.youtube.com/watch?v=xxxxx)",
          "condition": {
            "===": [
              {
                "var": "videoType"
              },
              "videourl"
            ]
          }
        },
        {
          "component": "aem-content",
          "name": "damAssetPath",
          "label": "DAM Asset Path",
          "description": "Select the video or media asset from the DAM",
          "condition": {
            "===": [
              {
                "var": "videoType"
              },
              "cta"
            ]
          }
        }
      ]
    }
  ],
  "filters": []
}
